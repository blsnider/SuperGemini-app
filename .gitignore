cat > .gitignore << 'EOF'
# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/

# Environment variables
.env
.env.local

# IDE
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
logs/

# Testing
.pytest_cache/
.coverage
htmlcov/

# Local files
*_local.*
*_backup_*
current-service.yaml
test_*.py

# OS
.DS_Store
Thumbs.db
EOF
